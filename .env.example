# Required in production
DATABASE_URL=
JWT_SECRET=
ADMIN_SECRET=
ADMIN_EMAIL=admin@qeixova.com
# Optional if ADMIN_SECRET is set. In production, ADMIN_SECRET is used as the login password when ADMIN_PASSWORD is empty.
ADMIN_PASSWORD=
SETUP_SECRET=

# Public app URL used in emails and links
NEXT_PUBLIC_APP_URL=

# Optional email delivery
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Flutterwave server-side payments (required for wallet and Premium checkout)
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
# Optional API endpoint override; normally leave unset
FLUTTERWAVE_V3_API_BASE_URL=
